{
    "name": "fifteenpeas/laravel-support",
    "description": "In-app support for fifteenpeas Laravel apps: an AI first line that answers only from the app's own docs, and a FreeScout second line.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "anthropic-ai/sdk": ">=0.51 <1.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/queue": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "laravel/mcp": "^1.0",
        "league/commonmark": "^2.10.2",
        "symfony/yaml": "^7.0|^8.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "FifteenPeas\\Support\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FifteenPeas\\Support\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "FifteenPeas\\Support\\SupportServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
